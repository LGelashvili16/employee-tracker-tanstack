{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist/gps"
  },
  "include": ["scripts/gps-*.ts", "src/features/gps/server/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
