# Copy to .env.docker. Generate two DIFFERENT secrets with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use a hex database password so it is safe inside DATABASE_URL.
POSTGRES_DB=employee_tracking
POSTGRES_USER=employee_tracking
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
BETTER_AUTH_SECRET=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8026
REDIS_PORT=6379
APP_PORT=3005

# Production: set a domain pointing at the VPS and its HTTPS URL.
APP_DOMAIN=localhost
APP_URL=http://localhost:3005

# Enable the cache profile before setting redis://redis:6379 for containers.
REDIS_URL=

# Production transactional SMTP. Local development uses Mailpit instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
