# Copy to docker/gps/gps.env on the VPS. Never commit the real secret.
GPS_PUBLIC_PORT=5505
GPS_PROTOCOL=auto
# Enable only after setting the numeric device ID and generating the secret.
GPS_REPLY=false
GPS_DEVICE_IDS=
GPS_AUTH_SECRET=
# Device timestamp offset from UTC, not the server's timezone.
GPS_UTC_OFFSET_MINUTES=0
GPS_JOURNAL_BYTES=10485760
GPS_JOURNAL_FILES=5
